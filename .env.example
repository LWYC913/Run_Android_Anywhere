# Local development only. Replace every credential before deploying.
API_BIND_ADDR=127.0.0.1:8080
METRICS_BIND_ADDR=127.0.0.1:9090

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/run_anywhere_dev
RUN_MIGRATIONS=true
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-local-admin-token

NATS_URL=nats://127.0.0.1:4222
# Production API and scheduler processes must each receive their own scoped
# identity and use a non-loopback tls:// or wss:// URL with one credential
# source. Local loopback development may leave these values blank.
NATS_CREDENTIALS_FILE=
NATS_NKEY_SEED_FILE=
NATS_TLS_CA_FILE=
NATS_TLS_CLIENT_CERT_FILE=
NATS_TLS_CLIENT_KEY_FILE=
# Production JetStream file storage must be backed by an encrypted volume (or
# configured with NATS JetStream encryption at rest); never use an unencrypted
# host path for JOB_QUEUE, JOB_DLQ, or JOB_ADVISORIES data.

SCHEDULER_METRICS_BIND_ADDR=127.0.0.1:9091
SCHEDULER_JOB_STREAM_MAX_BYTES=10737418240
SCHEDULER_DLQ_STREAM_MAX_BYTES=2147483648
SCHEDULER_ADVISORY_STREAM_MAX_BYTES=268435456
SCHEDULER_STREAM_REPLICAS=1
SCHEDULER_DLQ_RETENTION_SECONDS=2592000
SCHEDULER_ADVISORY_RETENTION_SECONDS=2592000
SCHEDULER_WORKER_HEARTBEAT_SECONDS=15
SCHEDULER_STALE_WORKER_SECONDS=45
SCHEDULER_ACK_WAIT_SECONDS=60
SCHEDULER_DATABASE_LEASE_SECONDS=75
SCHEDULER_MAX_RUN_ATTEMPTS=3
SCHEDULER_RECONCILE_INTERVAL_SECONDS=10
SCHEDULER_REAP_GRACE_SECONDS=120
SCHEDULER_PULL_BATCH_SIZE=64
SCHEDULER_MAX_ACK_PENDING=256
SCHEDULER_FAIRNESS_BUFFER_SIZE=1024
SCHEDULER_INTERACTIVE_WEIGHT=3
SCHEDULER_BATCH_WEIGHT=1
SCHEDULER_BATCH_AGING_SECONDS=300
SCHEDULER_DOCKER_ENDPOINT=
SCHEDULER_DOCKER_TIMEOUT_SECONDS=10

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=run-anywhere
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Generate this local-only Ed25519 key with `just dev-jwt-key`.
JWT_SIGNING_KEY_FILE=.local/debug-jwt-private.pem
JWT_KID=raa-debug-local-v1
DEBUG_TOKEN_TTL_SECONDS=900
DEBUG_GATEWAY_BASE_URL=http://127.0.0.1:8081

REQUEST_TIMEOUT_SECONDS=30
MAX_JSON_BODY_BYTES=1048576
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Leave blank to disable OTLP export during local development.
OTEL_EXPORTER_OTLP_ENDPOINT=
RUST_LOG=run_anywhere_api=info,run_anywhere_scheduler=info,tower_http=info
